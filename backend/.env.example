# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE
# ============================================
# MongoDB connection string
# Local: mongodb://localhost:27017/url_shortener
# Cloud: Get from MongoDB Atlas (https://cloud.mongodb.com)
DATABASE_URL=mongodb://localhost:27017/url_shortener

# ============================================
# CLOUDINARY (Image Upload)
# ============================================
# Sign up at: https://cloudinary.com
# Go to Dashboard → Account Details
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456

# ============================================
# SECURITY
# ============================================
# Number of salt rounds for bcrypt password hashing
# Recommended: 10-12 (higher = more secure but slower)
BCRYPT_SALT_ROUNDS=10

# JWT Secret Key - Generate a random secure string
# Generate online: https://randomkeygen.com (256-bit key)
# Or use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ============================================
# APPLICATION URLS
# ============================================
# Backend API URL (where your API is hosted)
BASE_URL=http://localhost:5000

# Frontend URL (for CORS and redirects)
ORIGIN_URL=http://localhost:3000

# ============================================
# EMAIL SERVICE (Gmail SMTP)
# ============================================
# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password!)
# How to get:
# 1. Go to: https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to: https://myaccount.google.com/apppasswords
# 4. Generate app password for "Mail"
GMAIL_PASS=abcd efgh ijkl mnop

# ============================================
# SSLCOMMERZ (Payment Gateway - Bangladesh)
# ============================================
# Sign up at: https://sslcommerz.com
# Get credentials from: Merchant Dashboard → API Credentials

# Test/Sandbox Credentials (for development)
# Store ID for sandbox
SSL_STORE_ID=your_store_id_here

# Store Password for sandbox
SSL_STORE_PASSWD=your_store_password_here

# false = Sandbox/Test mode, true = Live/Production mode
SSL_IS_LIVE=false